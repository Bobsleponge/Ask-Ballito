# ---------------------------------------------------------------------------
# Ask Ballito - environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo quick-login (local / staging ONLY — never enable on public production data)
# Server gate: ENABLE_DEMO_LOGIN. UI buttons: NEXT_PUBLIC_ENABLE_DEMO_LOGIN.
# In production BOTH are required, and DEMO_LOGIN_PASSWORD must be set to a
# non-default value (default AskBallitoDemo!2026 is rejected in production).
# ENABLE_DEMO_LOGIN=true
# NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
# DEMO_LOGIN_PASSWORD=use-a-unique-staging-password

# Supabase (required) -- Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: direct Postgres connection string for running migrations
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# OpenAI (required)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Optional: org daily chat turn budget for threshold alerts (defaults to global cap 2000)
# AI_DAILY_BUDGET_TURNS=2000

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (monitoring)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=ask-ballito

# Resend (email)
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=Ask Ballito <onboarding@resend.dev>

# Google Platform
GOOGLE_PLACES_API_KEY=your-server-places-key
# Optional: Weather API key (enable Weather API on the Google Cloud project).
# If unset, GOOGLE_PLACES_API_KEY is tried; if that fails, Open-Meteo is used.
# GOOGLE_WEATHER_API_KEY=your-weather-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-maps-key

# Upstash Redis (rate limiting)
# REQUIRED in production — /api/chat, /api/photo, /api/trending, /api/events,
# magic-link, and menu import fail closed (503) without these.
# Optional in local development (limiter no-ops so the app still runs).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cron (optional) — Bearer for /api/cron/search-restudy and /api/cron/purge-ai-logs.
# Vercel Cron sends Authorization: Bearer $CRON_SECRET automatically when set.
# CRON_SECRET=generate-a-long-random-string-min-16-chars
